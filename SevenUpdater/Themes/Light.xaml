<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Themes/Base.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- AdonisUI Light color scheme (values taken from AdonisUI 1.17.1), with this app's overrides -->
    <Color x:Key="AccentColor">#5080d8</Color>
    <Color x:Key="AccentHighlightColor">#6C9CF6</Color>
    <Color x:Key="AccentIntenseHighlightColor">#85AFFF</Color>
    <Color x:Key="AccentIntenseHighlightBorderColor">#85AFFF</Color>
    <Color x:Key="AccentInteractionColor">#568AE9</Color>
    <Color x:Key="AccentInteractionBorderColor">#568AE9</Color>
    <Color x:Key="Layer0BackgroundColor">#f3f3f3</Color> <!-- window background -->
    <Color x:Key="Layer0BorderColor">#f3f3f3</Color> <!-- window border and title bar -->
    <Color x:Key="Layer1BackgroundColor">#ededed</Color>
    <Color x:Key="Layer1BorderColor">#c4c4c4</Color>
    <Color x:Key="Layer1HighlightColor">#f4f4f4</Color>
    <Color x:Key="Layer1HighlightBorderColor">#b0b0b0</Color>
    <Color x:Key="Layer1IntenseHighlightColor">#fcfcfc</Color>
    <Color x:Key="Layer1IntenseHighlightBorderColor">#606060</Color>
    <Color x:Key="Layer2BackgroundColor">#f6f6f6</Color>
    <Color x:Key="Layer2BorderColor">#c0c0c0</Color>
    <Color x:Key="Layer2HighlightColor">#f4f4f4</Color>
    <Color x:Key="Layer2HighlightBorderColor">#808080</Color>
    <Color x:Key="Layer2IntenseHighlightColor">#ffffff</Color>
    <Color x:Key="Layer2IntenseHighlightBorderColor">#606060</Color>
    <Color x:Key="Layer3BackgroundColor">#e8e8e8</Color>
    <Color x:Key="Layer3BorderColor">#c8c8c8</Color>
    <Color x:Key="Layer3HighlightColor">#f6f6f6</Color>
    <Color x:Key="Layer3HighlightBorderColor">#808080</Color>
    <Color x:Key="Layer3IntenseHighlightColor">#ffffff</Color>
    <Color x:Key="Layer3IntenseHighlightBorderColor">#606060</Color>
    <Color x:Key="Layer4BackgroundColor">#f4f4f4</Color>
    <Color x:Key="Layer4BorderColor">#c0c0c0</Color>
    <Color x:Key="Layer4HighlightColor">#f4f4f4</Color>
    <Color x:Key="Layer4HighlightBorderColor">#929292</Color>
    <Color x:Key="Layer4IntenseHighlightColor">#ffffff</Color>
    <Color x:Key="Layer4IntenseHighlightBorderColor">#606060</Color>
    <Color x:Key="ForegroundColor">#212529</Color> <!-- window text -->
    <Color x:Key="AccentForegroundColor">#ffffff</Color>
    <Color x:Key="DisabledForegroundColor">#808080</Color>
    <Color x:Key="DisabledAccentForegroundColor">#d3d3d3</Color>
    <Color x:Key="SuccessColor">#00b94e</Color>
    <Color x:Key="ErrorColor">#dd2c00</Color>
    <Color x:Key="AlertColor">#ffa000</Color>
    <Color x:Key="HyperlinkColor">#0645ad</Color>
    <Color x:Key="WindowButtonHighlightColor">#e5e5e5</Color>
    <Color x:Key="WindowButtonInteractionColor">#cacaca</Color>
    <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>

    <BitmapImage x:Key="CameraImage" UriSource="../Resources/camera-dark.png" />
    <BitmapImage x:Key="ROGLogo" UriSource="/Resources/ROG/ROG-logo-red-40.png" />

    <SolidColorBrush x:Key="TextColor" Color="{StaticResource ForegroundColor}" />
    <SolidColorBrush x:Key="AccentTextColor" Color="#004b84" />
    <SolidColorBrush x:Key="SeparatorColor" Color="#e5e5e5" />
    <SolidColorBrush x:Key="PanelBackground" Color="#f3f3f3" />
    <SolidColorBrush x:Key="BottomPanelBackground" Color="#f3f3f3" />
    <SolidColorBrush x:Key="MainMenuPanelBackground" Color="#f3f3f3" />
    <SolidColorBrush x:Key="MenuItemBackground" Color="#f3f3f3" />
    <SolidColorBrush x:Key="ContentBackground" Color="#f7f7f7" />
    <SolidColorBrush x:Key="SuccessBackground" Color="#d4edda" />
    <SolidColorBrush x:Key="DisabledColor" Color="#a0a0a0" />
    <SolidColorBrush x:Key="WindowBorderColor" Color="#c4c4c4" />
</ResourceDictionary>
