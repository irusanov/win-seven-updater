<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Themes/Base.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- AdonisUI Dark color scheme (values taken from AdonisUI 1.17.1) with the DarkMint overrides -->
    <Color x:Key="AccentColor">#7ccaa2</Color> <!-- accent button and toggles -->
    <Color x:Key="AccentHighlightColor">#60cd95</Color> <!-- accent hover -->
    <Color x:Key="AccentIntenseHighlightColor">#5B74CD</Color>
    <Color x:Key="AccentIntenseHighlightBorderColor">#5ad394</Color> <!-- DarkMint -->
    <Color x:Key="AccentInteractionColor">#5ad394</Color> <!-- accent active -->
    <Color x:Key="AccentInteractionBorderColor">#5ad394</Color> <!-- DarkMint -->
    <Color x:Key="Layer0BackgroundColor">#1f2029</Color> <!-- window background -->
    <Color x:Key="Layer0BorderColor">#1f2029</Color> <!-- window title background -->
    <Color x:Key="Layer1BackgroundColor">#2a2b37</Color> <!-- dropdown and menu background, 5% lighter than window -->
    <Color x:Key="Layer1BorderColor">#2a2b37</Color> <!-- DarkMint -->
    <Color x:Key="Layer1HighlightColor">#353746</Color> <!-- dropdown and menu hover background -->
    <Color x:Key="Layer1HighlightBorderColor">#404255</Color> <!-- DarkMint -->
    <Color x:Key="Layer1IntenseHighlightColor">#5C5F74</Color>
    <Color x:Key="Layer1IntenseHighlightBorderColor">#A9A9C0</Color>
    <Color x:Key="Layer2BackgroundColor">#32323F</Color>
    <Color x:Key="Layer2BorderColor">#272730</Color>
    <Color x:Key="Layer2HighlightColor">#353746</Color> <!-- DarkMint -->
    <Color x:Key="Layer2HighlightBorderColor">#353746</Color> <!-- DarkMint -->
    <Color x:Key="Layer2IntenseHighlightColor">#454555</Color>
    <Color x:Key="Layer2IntenseHighlightBorderColor">#7B7B99</Color>
    <Color x:Key="Layer3BackgroundColor">#262630</Color>
    <Color x:Key="Layer3BorderColor">#14151a</Color> <!-- DarkMint -->
    <Color x:Key="Layer3HighlightColor">#3B3D4A</Color>
    <Color x:Key="Layer3HighlightBorderColor">#484B60</Color>
    <Color x:Key="Layer3IntenseHighlightColor">#464859</Color>
    <Color x:Key="Layer3IntenseHighlightBorderColor">#717590</Color>
    <Color x:Key="Layer4BackgroundColor">#323341</Color>
    <Color x:Key="Layer4BorderColor">#414255</Color>
    <Color x:Key="Layer4HighlightColor">#38394A</Color>
    <Color x:Key="Layer4HighlightBorderColor">#51516B</Color>
    <Color x:Key="Layer4IntenseHighlightColor">#48495C</Color>
    <Color x:Key="Layer4IntenseHighlightBorderColor">#7F7F90</Color>
    <Color x:Key="ForegroundColor">#D1D4C9</Color> <!-- text color -->
    <Color x:Key="AccentForegroundColor">#1f2029</Color> <!-- DarkMint -->
    <Color x:Key="DisabledForegroundColor">#8E8E8E</Color>
    <Color x:Key="DisabledAccentForegroundColor">#ACACAC</Color>
    <Color x:Key="SuccessColor">#00b14a</Color>
    <Color x:Key="ErrorColor">#b00020</Color>
    <Color x:Key="AlertColor">#ffc107</Color>
    <Color x:Key="HyperlinkColor">#3377c6</Color>
    <Color x:Key="WindowButtonHighlightColor">#353746</Color> <!-- window button hover -->
    <Color x:Key="WindowButtonInteractionColor">#4C4F62</Color>
    <!-- Title bar theme switch: shows the theme you switch TO -->
    <Geometry x:Key="ThemeToggleIcon">F1 M3.55 19.09L4.96 20.5L6.76 18.71L5.34 17.29M12 6C8.69 6 6 8.69 6 12S8.69 18 12 18 18 15.31 18 12C18 8.68 15.31 6 12 6M20 13H23V11H20M17.24 18.71L19.04 20.5L20.45 19.09L18.66 17.29M20.45 5L19.04 3.6L17.24 5.39L18.66 6.81M13 1H11V4H13M6.76 5.39L4.96 3.6L3.55 5L5.34 6.81L6.76 5.39M1 13H4V11H1M13 20H11V23H13</Geometry> <!-- same as IconWhiteBalanceSunny -->
    <sys:String x:Key="ThemeToggleToolTip">Switch to light theme</sys:String>

    <CornerRadius x:Key="ControlCornerRadius">2</CornerRadius>

    <SolidColorBrush x:Key="AccentTextColor" Color="{StaticResource AccentColor}" />

    <!-- Panels -->
    <SolidColorBrush x:Key="PanelBackground" Color="{StaticResource Layer0BackgroundColor}" />
    <SolidColorBrush x:Key="BottomPanelBackground" Color="{StaticResource Layer0BackgroundColor}" />
    <SolidColorBrush x:Key="MainMenuPanelBackground" Color="{StaticResource Layer0BackgroundColor}" />
    <SolidColorBrush x:Key="MenuItemBackground" Color="{StaticResource Layer0BackgroundColor}" />

    <SolidColorBrush x:Key="TextColor" Color="{StaticResource ForegroundColor}" />
    <SolidColorBrush x:Key="SeparatorColor" Color="{StaticResource Layer3BorderColor}" />
    <SolidColorBrush x:Key="SuccessBackground" Color="#327b56" />
    <SolidColorBrush x:Key="DisabledColor" Color="#5b5b70" />
    <SolidColorBrush x:Key="WindowBorderColor" Color="{StaticResource Layer3BorderColor}" />
</ResourceDictionary>
